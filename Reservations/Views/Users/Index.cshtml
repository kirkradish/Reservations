@{
    
}
@model List<Reservations.Models.Person>
@Html.AntiForgeryToken()

@section Styles {
    <link href="https://cdn.datatables.net/v/dt/dt-3.1.4/datatables.min.css" rel="stylesheet">
}

<div class="text-center">
    <h1 class="display-4">Users List</h1>

    <table id="usersTable" class="table table-striped table-bordered" style="width: 100%">
        <thead>
            <tr>
                <th>Select</th>
                <th>First Name</th>
                <th>Middle Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var person in Model)
            {
                <tr>
                    <td><a asp-controller="Users" asp-action="Profile" asp-route-id="@person.Id">View</a></td>
                    <td>@person.FirstName</td>
                    <td>@person.MiddleName</td>
                    <td>@person.LastName</td>
                    <td>@person.Email</td>
                    <td>@person.PhoneNumber</td>
                    <td><a href="#" onclick="deleteUser(@person.Id); return false;">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.4/datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize the DataTable targeting your table ID
            $('#usersTable').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 10 // Default row display limit
            });
        });

        // Implemet Delete Functionality
        async function deleteUser(id) {
            if (!confirm("Are you sure you wan to delete this user?")) {
                return;
            }

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;

            try {
                const response = await fetch(
                    `/Users/DeleteUser/${id}`, {
                    method: "POST",
                        headers: {
                            "RequestVerificationToken": token
                        }
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert("Unable to delete user.");
                }
            }
            catch (error) {
                console.error("Delete error:", error);
                alert("An error occurred while deleting the user.");
            }
        }
    </script>
}
