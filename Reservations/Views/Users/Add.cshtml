@{
    var newPerson = new Reservations.Models.NewPersonViewModel();
}

@section Styles {
    <style>
        .page-header { margin: 0 0 3em 0; }
    </style>
}

<div class="page-header text-center">
    <h1 class="display-4">Add User</h1>
</div>

<div class="d-flex justify-content-center align-items-center">
    <div class="w-100 col-md-6" style="max-width: 500px;">
        @await Html.PartialAsync(
            "_UserForm",
            new NewPersonViewModel(),
            new ViewDataDictionary(ViewData) { { "FormType", "AddUser" } }
        )
    </div>
</div>
