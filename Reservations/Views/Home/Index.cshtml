@{
    ViewData["Title"] = "Home Page";
    var newPerson = new Reservations.Models.NewPersonViewModel();
}
@model List<Reservations.Models.Person>

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    @foreach (var person in Model) {
        <p>@person.FirstName @person.MiddleName @person.LastName</p>
    }

    <form method="post" asp-action="AddPerson">
        <div>
            <label asp-for="@newPerson.FirstName">First Name</label>
            <input aps-for="@newPerson.FirstName" class="form-control" name="FirstName" />
            <span asp-validation-for="@newPerson.FirstName" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="@newPerson.MiddleName">First Name</label>
            <input aps-for="@newPerson.MiddleName" class="form-control" name="MiddleName" />
            <span asp-validation-for="@newPerson.MiddleName" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="@newPerson.LastName">First Name</label>
            <input aps-for="@newPerson.LastName" class="form-control" name="LastName" />
            <span asp-validation-for="@newPerson.LastName" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Add Contact</button>
    </form>
</div>
